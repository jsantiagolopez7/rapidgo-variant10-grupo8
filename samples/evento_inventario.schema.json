{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evento de inventario y picking - RapidGo Grupo 8",
  "type": "object",
  "required": ["event_id", "team", "event_type", "event_ts", "store_id", "order_id", "sku",
               "qty_requested", "qty_picked", "stock_after", "pick_start_ts", "pick_end_ts"],
  "properties": {
    "event_id": {"type": "string"},
    "team": {"const": "grupo8"},
    "event_type": {"enum": ["ORDER_RECEIVED", "ITEM_PICKED", "ITEM_OUT_OF_STOCK",
                            "ORDER_PICKING_COMPLETED", "STOCK_REPLENISHED"]},
    "event_ts": {"type": "string", "format": "date-time"},
    "store_id": {"type": "string", "pattern": "^STORE-[0-9]{2}$"},
    "order_id": {"type": "string"},
    "sku": {"type": "string", "pattern": "^SKU-[0-9]{4}$"},
    "category": {"type": "string"},
    "qty_requested": {"type": "integer", "minimum": 1},
    "qty_picked": {"type": "integer", "minimum": 0},
    "stock_before": {"type": "integer", "minimum": 0},
    "stock_after": {"type": "integer", "minimum": 0},
    "picker_id": {"type": "string"},
    "pick_start_ts": {"type": "string", "format": "date-time"},
    "pick_end_ts": {"type": "string", "format": "date-time"}
  }
}
